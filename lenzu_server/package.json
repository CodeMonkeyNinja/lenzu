{
  "name": "lenzu-hud",
  "version": "0.3.0",
  "description": "A transparent HUD-like overlay for Linux desktop displaying UDP text as closed-caption/subtitle",
  "main": "dist/main.js",
  "homepage": "https://github.com/CodeMonkeyNinja/lenzu",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeMonkeyNinja/lenzu.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "GTK_CSD=0 node_modules/.bin/electron dist/main.js",
    "test:send": "node test_sender.js",
    "deb": "npm run build && electron-builder --linux deb"
  },
  "keywords": [
    "electron",
    "hud",
    "overlay",
    "transparent",
    "udp",
    "subtitles",
    "captions",
    "linux"
  ],
  "author": {
    "name": "Hideki A. Ikeda",
    "email": "hidekiai@CodeMonkeyNinja.dev@users.noreply.github.com"
  },
  "license": "MIT",
  "//": "Electron 42.3.3 confirmed: the xfwm4 ghost-pixel issue (Electron 36–41) is fixed. No picom needed.",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "electron": "42.3.3",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "io.github.codemonkeyninja.lenzu.hud",
    "productName": "lenzu-hud",
    "executableName": "lenzu-hud",
    "files": [
      "dist/**/*",
      "hud_config.json",
      "package.json",
      "!dist/hud-set-override-redirect"
    ],
    "extraResources": [
      {
        "from": "dist/hud-set-override-redirect",
        "to": "hud-set-override-redirect"
      }
    ],
    "directories": {
      "output": "dist-deb"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "synopsis": "Transparent desktop HUD for Lenzu OCR overlay",
      "maintainer": "Hideki A. Ikeda <hidekiai@CodeMonkeyNinja.dev@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libx11-6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libxcb-dri3-0"
      ]
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.2",
    "@grpc/proto-loader": "^0.7.13",
    "effect": "^3.21.4"
  }
}
